---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { generatePageMetadata } from '../../lib/seo';
import { getFeaturedPoems, getPosterUrl } from '../../lib/cdn';

const siteOrigin = Astro.site?.toString()?.replace(/\/$/, '') || 'https://library.linespedia.com';
const meta = generatePageMetadata({
  pageType: 'archive',
  data: {
    title: 'Quote Posters',
    description: 'Download beautiful quote posters for social media, WhatsApp status, and Instagram stories. Free poetic line posters.',
  },
  siteOrigin,
  pathname: '/posters/',
  fallbackTitle: 'Quote Posters — Download & Share',
  fallbackDescription: 'Download beautiful quote posters for social media, WhatsApp status, and Instagram stories.',
});

const poems = await getFeaturedPoems();
const postersWithUrls = poems
  .map(p => ({ ...p, posterUrl: getPosterUrl(p.slug) }))
  .filter(p => p.posterUrl)
  .slice(0, 24);
---

<Layout title={meta.title} description={meta.description} canonicalURL={meta.canonicalURL} robots={meta.robots}>
  <Navbar />
  <main class="min-h-screen">
    <section class="container mx-auto px-4 py-20 text-center max-w-3xl">
      <span class="inline-block px-4 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-bold uppercase tracking-widest mb-6">Free Downloads</span>
      <h1 class="text-4xl md:text-5xl font-serif font-black text-primary mb-6 leading-tight">
        Quote Posters
      </h1>
      <p class="text-lg text-primary/60 leading-relaxed">
        Download beautifully designed quote posters. Perfect for Instagram stories, WhatsApp status, Pinterest, and social media sharing.
      </p>
    </section>

    <section class="container mx-auto px-4 pb-20">
      {postersWithUrls.length > 0 ? (
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          {postersWithUrls.map((poem) => (
            <a href={`/line/${poem.slug}/`} class="group block">
              <div class="aspect-square rounded-2xl overflow-hidden border border-indigo-50 shadow-sm group-hover:shadow-xl transition-all">
                <img
                  src={poem.posterUrl}
                  alt={`${poem.content?.slice(0, 50) || 'Quote'} Poster`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <p class="mt-3 text-sm font-medium text-primary/70 line-clamp-2">{poem.content?.slice(0, 80)}...</p>
              <span class="text-xs text-primary/40 font-bold uppercase tracking-wider">{poem.writer}</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <p class="text-primary/40 text-lg">Posters are being generated. Check back soon!</p>
          <a href="/explore/" class="inline-block mt-6 px-8 py-3 bg-primary text-white rounded-full font-bold text-sm">
            Browse Poems
          </a>
        </div>
      )}
    </section>
  </main>
  <Footer />
</Layout>
