---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PoemCard from '../../components/PoemCard.astro';
import { Calendar, ArrowRight } from 'lucide-astro';
import { getFeaturedPoems, getAllWriters, getWriterPoems } from '../../lib/cdn';
import { buildCanonicalUrl, getNormalizedLang, getSiteOrigin, shouldNoindexForLanguageParam } from '../../lib/seo';

const allPoems = await getFeaturedPoems();
const writers = await getAllWriters();

// Seeded random selection based on today's date (consistent throughout the day)
const today = new Date().toDateString();
const seed = today.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
const poemIndex = seed % allPoems.length;
const poemOfTheDay = allPoems[poemIndex];

// Get writer data
const writer = writers.find((w: any) => 
  slugify(w.name) === slugify(poemOfTheDay.writer) || w.slug === poemOfTheDay.writer
) || { name: poemOfTheDay.writer, slug: slugify(poemOfTheDay.writer), photo: null };

// Language detection
const supportedLanguages: string[] = ["en", "es", "fr", "de", "hi", "ar", "zh", "ja", "ru", "pt", "it"];
const requestedLang = Astro.url.searchParams.get("lang") || "en";
const lang = supportedLanguages.includes(requestedLang) ? requestedLang : "en";
const siteOrigin = getSiteOrigin(Astro.site, Astro.url.origin);
const canonicalURL = buildCanonicalUrl('/poem-of-the-day/', siteOrigin);
const shouldNoindex = getNormalizedLang(requestedLang) !== 'en';
const isTranslationParamPage = shouldNoindexForLanguageParam(Astro.url.searchParams);
const robots = shouldNoindex
  ? 'noindex,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'
  : 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1';

function slugify(text: string): string {
  return text
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/[\s_-]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

// OG image uses our dynamic endpoint
const ogImage = new URL(`/api/og/${poemOfTheDay.slug}`, siteOrigin);
---

<Layout 
  title="Poem of the Day — Linespedia"
  description={`Today's featured poem: "${poemOfTheDay.content.substring(0, 100)}..." by ${writer.name}`}
  lang={lang}
  canonicalURL={canonicalURL}
  robots={robots}
  keywords="poem of the day, daily poetry, featured poem, today's poem, inspirational poetry"
  image={ogImage.toString()}
  type="article"
  publishedTime={new Date().toISOString().split('T')[0]}
  author={new URL(`/${writer.slug}/`, siteOrigin).toString()}
  tags={['Featured', 'Poem of the Day', writer.name]}
>
  {!isTranslationParamPage && <meta slot="head" name="lang-trigger" content={lang} />}

  <Navbar />

  <main class="min-h-screen">
    <div class="poetic-gradient py-24 border-b border-indigo-50">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <div class="inline-flex items-center space-x-2 px-4 py-2 bg-accent/10 rounded-full mb-6">
          <Calendar class="text-accent" size={16} />
          <span class="text-xs font-bold uppercase tracking-widest text-accent">Poem of the Day</span>
        </div>
        <h1 class="text-5xl md:text-7xl font-serif font-black text-primary mb-6">
          Today's <span class="text-accent">Poetic</span> Pick
        </h1>
        <p class="text-xl text-primary/60 max-w-2xl mx-auto">
          A handpicked verse to inspire your day. Refresh tomorrow for a new selection.
        </p>
      </div>
    </div>

    <div class="container mx-auto px-4 py-20 max-w-4xl">
      <article class="bg-white/70 backdrop-blur-2xl border border-white/40 rounded-[4rem] p-10 md:p-16 shadow-2xl relative overflow-hidden group">
        <div class="absolute top-0 right-0 p-12 opacity-[0.03] text-primary group-hover:scale-110 transition-transform duration-700">
          <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="currentColor"><path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z"/></svg>
        </div>
        
        <div class="relative z-10 text-center">
          <header class="mb-12">
            <h1 class="text-3xl md:text-5xl font-serif font-black text-primary leading-tight mb-4">
              {poemOfTheDay.content}
            </h1>
            {writer && (
              <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary/40">
                By <a href={`/${writer.slug}/`} class="hover:text-accent transition-colors">{writer.name}</a>
              </p>
            )}
          </header>
        </div>
      </article>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-indigo-50/40 backdrop-blur-md rounded-[2.5rem] p-8 border border-indigo-100/30">
          <h3 class="text-xl font-serif font-black text-primary mb-4">Share Today's Poem</h3>
          <p class="text-primary/70 mb-6">Spread the poetry. Use the buttons below to share this beautiful verse with your friends and followers.</p>
          <div class="flex flex-wrap gap-3">
            <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`"${poemOfTheDay.content.substring(0, 140)}..."`)}&url=${encodeURIComponent(siteOrigin + '/poem-of-the-day/')}`} 
               target="_blank" rel="noopener noreferrer"
               class="px-6 py-3 bg-[#1DA1F2] text-white rounded-full font-bold hover:bg-[#1a8cd8] transition-all">
              Share on Twitter
            </a>
            <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`"${poemOfTheDay.content.substring(0, 140)}..." \n${siteOrigin}/poem-of-the-day/`)}`}
               target="_blank"
               class="px-6 py-3 bg-[#25D366] text-white rounded-full font-bold hover:bg-[#20bd5a] transition-all">
              WhatsApp
            </a>
            <button onclick="navigator.clipboard.writeText(window.location.href).then(()=>alert('Link copied!'))"
               class="px-6 py-3 bg-white border border-indigo-100 rounded-full font-bold text-primary hover:bg-indigo-50 transition-all">
              Copy Link
            </button>
          </div>
        </div>

        <div class="bg-indigo-900 text-white rounded-[2.5rem] p-8">
          <h3 class="text-xl font-serif font-bold mb-4">Explore More</h3>
          <p class="text-white/80 mb-6">Discover thousands of curated poems from famous poets and hidden gems.</p>
          <a href="/explore/" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-primary rounded-full font-bold hover:bg-accent hover:text-white transition-all">
            Browse Collection <ArrowRight size={18} />
          </a>
        </div>
      </div>

      {/* More poems from same writer */}
      {writer && (
        <div class="mt-20">
          <h2 class="text-3xl font-serif font-black text-primary mb-10 flex items-center gap-3">
            <span>More by {writer.name}</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {(await getWriterPoems(writer.slug))
              .filter((p: any) => p.slug !== poemOfTheDay.slug)
              .slice(0, 6)
              .map((poem: any) => (
                <PoemCard
                  id={poem.id}
                  slug={poem.slug}
                  content={poem.content}
                  writer={poem.writer}
                  writerName={writer.name}
                />
              ))}
          </div>
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>
