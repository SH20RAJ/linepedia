---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import PoemCard from '../components/PoemCard.astro';
import StructuredData from '../components/StructuredData.astro';
import { Quote } from 'lucide-astro';

import { getAllWriters, getAllCollections, getAllCategories, getFeaturedPoems } from '../lib/cdn';
import { buildCanonicalUrl, generatePageMetadata, getNormalizedLang, getSiteOrigin, SUPPORTED_LANGUAGES, shouldNoindexForLanguageParam } from '../lib/seo';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection("blog"))
  .filter((post) => !post.data.noindex)
  .sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
const latestPosts = allPosts.slice(0, 3);

const writersData = await getAllWriters();
const collectionsData = await getAllCollections();
const categoriesData = await getAllCategories();
const poemsData = await getFeaturedPoems();

const featuredPoems = poemsData.slice(0, 9);
const trendingCategories = categoriesData.slice(0, 8);
const featuredWriters = writersData.slice(0, 12);
const featuredCollections = collectionsData.slice(0, 4);

// SEO: Poem of the Day (random but stable for the day)
const today = new Date().toDateString();
const seed = today.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
const poemOfTheDay = poemsData[seed % poemsData.length] || poemsData[0];

// Trending Lines (last 6)
const trendingLines = poemsData.slice(-6).reverse();

// Language detection for hreflang and meta
const supportedLanguages = [...SUPPORTED_LANGUAGES];
const requestedLang = Astro.url.searchParams.get("lang") || "en";
const lang = (supportedLanguages.includes(requestedLang as any) ? requestedLang : "en") as typeof SUPPORTED_LANGUAGES[number];
const siteOrigin = getSiteOrigin(Astro.site, Astro.url.origin);
const isTranslationParamPage = shouldNoindexForLanguageParam(Astro.url.searchParams);
const homeMeta = generatePageMetadata({
	pageType: 'home',
	data: {
		description: 'Discover curated shayari, poems, quotes, captions, writer pages, meanings, and shareable poetic lines on Linespedia.',
	},
	siteOrigin,
	pathname: '/',
	lang,
	translationsServerSide: false,
	isTranslationParamPage,
	fallbackTitle: 'Linespedia — Shayari, Poems, Quotes & Poetic Lines',
	fallbackDescription: 'Discover curated shayari, poems, quotes, captions, writer pages, meanings, and shareable poetic lines.',
});
---

<Layout 
  title={homeMeta.title} 
  description={homeMeta.description}
  lang={lang}
	canonicalURL={homeMeta.canonicalURL}
	robots={homeMeta.robots}
	ogTitle={homeMeta.ogTitle}
	ogDescription={homeMeta.ogDescription}
	ogUrl={homeMeta.ogUrl}
	twitterCard={homeMeta.twitterCard}
  keywords="poetry archive, shayari archive, quotes archive, poetry collections, writer pages"
>
  <meta slot="head" name="lang-trigger" content={lang} />
  
  <StructuredData
    type="category"
    title="Linespedia — Shayari, Poems, Quotes & Poetic Lines"
    description="Discover curated shayari, poems, quotes, captions, writer pages, meanings, and shareable poetic lines."
    url="/"
    breadcrumbs={[]}
  />
	<Navbar />

	<main>
		<Hero />

 		{/* Poem of the Day — Fresh Content Signal */}
 		{poemOfTheDay && (
 			<section class="container mx-auto px-4 -mt-12 relative z-20">
 				<div class="bg-primary text-white p-8 md:p-12 rounded-[2.5rem] shadow-2xl overflow-hidden relative group">
 					<div class="absolute top-0 right-0 p-8 opacity-10 group-hover:scale-110 transition-transform"><Quote size={120} /></div>
 					<div class="max-w-3xl">
 						<span class="inline-block px-4 py-1 bg-white/10 rounded-full text-xs font-bold uppercase tracking-widest mb-6 border border-white/10">Poem of the Day</span>
 						<blockquote class="text-2xl md:text-4xl font-serif italic mb-8 leading-relaxed">
 							"{poemOfTheDay.content.slice(0, 150)}..."
 						</blockquote>
 						<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
 							<a href={`/line/${poemOfTheDay.slug}/`} class="flex items-center space-x-3 group/author">
 								<div class="w-10 h-10 rounded-full bg-white/20 border border-white/20 overflow-hidden">
 									<img src={`https://api.dicebear.com/7.x/avataaars/svg?seed=${poemOfTheDay.writer}`} alt={poemOfTheDay.writer} />
 								</div>
 								<span class="font-bold border-b border-transparent group-hover/author:border-white transition-all underline-offset-4">{writersData.find((w: any) => w.slug === poemOfTheDay.writer)?.name || poemOfTheDay.writer}</span>
 							</a>
 							<div class="flex items-center gap-3">
 								<a href={`/line/${poemOfTheDay.slug}/`} class="px-6 py-3 bg-white text-primary rounded-full font-bold text-sm hover:bg-accent hover:text-white transition-all shadow-lg">Read Full Poem &rarr;</a>
 								<a href="/poem-of-the-day/" class="px-6 py-3 bg-white/20 border border-white/20 text-white rounded-full font-bold text-sm hover:bg-white hover:text-primary transition-all">Visit Page</a>
 							</div>
 						</div>
 					</div>
 				</div>
 			</section>
		)}

		{/* Trending Categories */}
		<section class="container mx-auto px-4 py-16">
			<div class="flex items-end justify-between mb-8">
				<div>
					<h2 class="text-3xl font-serif font-black text-primary">Trending Categories</h2>
					<p class="text-primary/50 mt-1">Explore curated themes and moods</p>
				</div>
				<a href="/categories/" class="text-accent font-bold text-sm uppercase tracking-widest hover:underline">View All</a>
			</div>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
				{trendingCategories.map((cat: any) => (
					<a href={`/${cat.slug}/`} class="group p-6 bg-white border border-indigo-50 rounded-2xl shadow-sm hover:shadow-xl transition-all card-hover">
						<h3 class="text-xl font-serif font-bold text-primary group-hover:text-accent transition-colors mb-2">{cat.name}</h3>
						<p class="text-xs text-primary/40 line-clamp-2">{cat.description}</p>
					</a>
				))}
			</div>
		</section>

		{/* Featured Writers */}
		<section class="bg-indigo-50/50 py-16">
			<div class="container mx-auto px-4">
				<div class="flex items-end justify-between mb-12">
					<div>
						<h2 class="text-3xl font-serif font-black text-primary">Featured Poets</h2>
						<p class="text-primary/50 mt-1">The masters of the spoken word</p>
					</div>
					<a href="/writers/" class="text-accent font-bold text-sm uppercase tracking-widest hover:underline">See All</a>
				</div>
				<div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-8">
					{featuredWriters.map((writer: any) => (
						<a href={`/${writer.slug}/`} class="flex flex-col items-center group">
							<img src={writer.photo} alt={writer.name} class="w-20 h-20 md:w-28 md:h-28 rounded-full object-cover shadow-lg border-4 border-white card-hover mb-4" loading="lazy" />
							<h3 class="text-sm md:text-base font-bold text-primary group-hover:text-accent transition-colors text-center">{writer.name}</h3>
							<span class="text-[10px] text-primary/40 font-medium uppercase tracking-widest">{writer.stats.poems} Poems</span>
						</a>
					))}
				</div>
			</div>
		</section>

		{/* Popular Collections */}
		<section class="container mx-auto px-4 py-16">
			<div class="flex items-end justify-between mb-12">
				<div>
					<h2 class="text-3xl font-serif font-black text-primary">Popular Collections</h2>
					<p class="text-primary/50 mt-1">Curated for every mood and occasion</p>
				</div>
				<a href="/collections/" class="text-accent font-bold text-sm uppercase tracking-widest hover:underline">View All</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{featuredCollections.map((col: any) => (
					<a href={`/${col.slug}/`} class="group p-8 bg-white border border-indigo-50 rounded-[2rem] shadow-sm hover:shadow-xl transition-all card-hover">
						<h3 class="text-2xl font-serif font-bold text-primary group-hover:text-accent transition-colors mb-3">{col.name}</h3>
						<p class="text-primary/50 text-sm line-clamp-2 mb-4">{col.description}</p>
						<span class="text-xs font-bold uppercase tracking-widest text-accent">Browse Collection &rarr;</span>
					</a>
				))}
			</div>
		</section>

		{/* Latest Lines Grid */}
		<section class="container mx-auto px-4 py-16">
			<div class="flex items-end justify-between mb-12">
				<div>
					<h2 class="text-3xl font-serif font-black text-primary">Latest Lines</h2>
					<p class="text-primary/50 mt-1">Freshly curated poetry and shayari</p>
				</div>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{featuredPoems.map((poem: any) => (
					<PoemCard
						id={poem.id}
						slug={poem.slug}
						content={poem.content.slice(0, 200)}
						writer={poem.writer}
						writerName={writersData.find((w: any) => w.slug === poem.writer)?.name || poem.writer}
					/>
				))}
			</div>
			<div class="mt-16 flex justify-center">
				<a href="/explore/" class="px-12 py-4 bg-white border border-indigo-100 rounded-full text-primary font-bold shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all">
					Explore All Lines &rarr;
				</a>
			</div>
		</section>

		{/* Why Linespedia? — Trust Section */}
		<section class="container mx-auto px-4 py-16">
			<h2 class="text-3xl font-serif font-black text-primary mb-12 text-center">Why Linespedia?</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="text-center p-8 bg-white rounded-2xl border border-indigo-50 shadow-sm">
					<div class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
						<svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					</div>
					<h3 class="text-xl font-serif font-bold text-primary mb-3">Attributed &amp; Public Domain</h3>
					<p class="text-primary/60 text-sm leading-relaxed">Every poem includes source attribution and author credit. Public domain works are clearly marked.</p>
				</div>
				<div class="text-center p-8 bg-white rounded-2xl border border-indigo-50 shadow-sm">
					<div class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
						<svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
					</div>
					<h3 class="text-xl font-serif font-bold text-primary mb-3">Curated Meanings</h3>
					<p class="text-primary/60 text-sm leading-relaxed">Each line comes with context and meaning, helping you understand and appreciate the poetry.</p>
				</div>
				<div class="text-center p-8 bg-white rounded-2xl border border-indigo-50 shadow-sm">
					<div class="w-16 h-16 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-6">
						<svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
					</div>
					<h3 class="text-xl font-serif font-bold text-primary mb-3">Shareable Posters</h3>
					<p class="text-primary/60 text-sm leading-relaxed">Download beautiful quote posters for Instagram, WhatsApp, and Pinterest.</p>
				</div>
			</div>
		</section>

		{/* Trending Now Sidebar/Section — Internal Linking Boost */}
		<section class="bg-white py-16 border-y border-indigo-50">
			<div class="container mx-auto px-4">
				<div class="flex items-center space-x-2 mb-10">
					<div class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></div>
					<h2 class="text-xl font-bold uppercase tracking-widest text-primary/40">Trending Now</h2>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					{trendingLines.map((line: any) => (
						<a href={`/line/${line.slug}/`} class="flex items-start space-x-4 p-4 rounded-2xl hover:bg-indigo-50 transition-all border border-transparent hover:border-indigo-100 group">
							<div class="w-12 h-12 rounded-xl bg-primary/5 flex items-center justify-center grow-0 shrink-0 text-primary group-hover:bg-primary group-hover:text-white transition-all">
								<Quote size={20} />
							</div>
							<div>
								<p class="text-primary font-medium line-clamp-2 mb-1">"{line.content.slice(0, 100)}..."</p>
								<span class="text-xs text-primary/40 font-bold uppercase tracking-wider">{writersData.find((w: any) => w.slug === line.writer)?.name || line.writer}</span>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		{/* Latest Blog Posts — Premium Content Signal */}
		<section class="bg-indigo-50/30 py-24 border-y border-indigo-50">
			<div class="container mx-auto px-4">
				<div class="flex items-end justify-between mb-12">
					<div>
						<h2 class="text-4xl font-serif font-black text-primary">Poetic Journal</h2>
						<p class="text-primary/50 mt-2 text-lg">Insights, guides, and trends from the world of words</p>
					</div>
					<a href="/blog/" class="hidden md:block px-8 py-3 bg-white border border-indigo-100 rounded-full text-primary font-bold text-sm shadow-sm hover:shadow-xl transition-all">
						View All Articles &rarr;
					</a>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-10">
					{latestPosts.map((post) => (
						<article class="group">
							<a href={`/blog/${post.id}/`} class="block mb-6 overflow-hidden rounded-[2.5rem] aspect-video bg-white shadow-lg shadow-indigo-100/20">
								<img 
									src={post.data.heroImage} 
									alt={post.data.title}
									class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
								/>
							</a>
							<div class="flex items-center space-x-3 mb-4">
								<span class="px-3 py-1 bg-accent/10 text-accent text-[10px] font-black uppercase tracking-widest rounded-full">
									{post.data.category.replace('_', ' ')}
								</span>
								<time class="text-[10px] text-primary/30 font-bold uppercase tracking-widest italic">
									{post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
								</time>
							</div>
							<h3 class="text-2xl font-serif font-black text-primary mb-3 group-hover:text-accent transition-colors leading-tight">
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							</h3>
							<p class="text-primary/50 text-sm line-clamp-2 mb-6">
								{post.data.description}
							</p>
						</article>
					))}
				</div>
				<div class="mt-12 md:hidden">
					<a href="/blog/" class="block w-full py-4 bg-white border border-indigo-100 rounded-2xl text-primary font-bold text-center shadow-sm">
						View All Articles &rarr;
					</a>
				</div>
			</div>
		</section>

		{/* Quick Access — High-Intent Entry Points */}
		<section class="bg-indigo-50/50 py-16 border-y border-indigo-50">
			<div class="container mx-auto px-4 max-w-5xl">
				<h2 class="text-2xl font-serif font-black text-primary text-center mb-10">Popular Collections</h2>
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
					<a href="/sad-shayari/" class="group bg-white p-5 rounded-2xl border border-indigo-50 hover:border-accent hover:shadow-lg transition-all text-center">
						<span class="text-2xl block mb-2">💔</span>
						<span class="font-bold text-sm text-primary group-hover:text-accent transition-colors">Sad Shayari</span>
					</a>
					<a href="/love-poetry/" class="group bg-white p-5 rounded-2xl border border-indigo-50 hover:border-accent hover:shadow-lg transition-all text-center">
						<span class="text-2xl block mb-2">❤️</span>
						<span class="font-bold text-sm text-primary group-hover:text-accent transition-colors">Love Poetry</span>
					</a>
					<a href="/deep-lines/" class="group bg-white p-5 rounded-2xl border border-indigo-50 hover:border-accent hover:shadow-lg transition-all text-center">
						<span class="text-2xl block mb-2">🌊</span>
						<span class="font-bold text-sm text-primary group-hover:text-accent transition-colors">Deep Lines</span>
					</a>
					<a href="/nature-poetry/" class="group bg-white p-5 rounded-2xl border border-indigo-50 hover:border-accent hover:shadow-lg transition-all text-center">
						<span class="text-2xl block mb-2">🌿</span>
						<span class="font-bold text-sm text-primary group-hover:text-accent transition-colors">Nature Poetry</span>
					</a>
					<a href="/motivational-lines/" class="group bg-white p-5 rounded-2xl border border-indigo-50 hover:border-accent hover:shadow-lg transition-all text-center">
						<span class="text-2xl block mb-2">🔥</span>
						<span class="font-bold text-sm text-primary group-hover:text-accent transition-colors">Motivational</span>
					</a>
					<a href="/romantic-poetry/" class="group bg-white p-5 rounded-2xl border border-indigo-50 hover:border-accent hover:shadow-lg transition-all text-center">
						<span class="text-2xl block mb-2">🌹</span>
						<span class="font-bold text-sm text-primary group-hover:text-accent transition-colors">Romantic Poetry</span>
					</a>
					<a href="/spiritual-poetry/" class="group bg-white p-5 rounded-2xl border border-indigo-50 hover:border-accent hover:shadow-lg transition-all text-center">
						<span class="text-2xl block mb-2">🕊️</span>
						<span class="font-bold text-sm text-primary group-hover:text-accent transition-colors">Spiritual</span>
					</a>
					<a href="/urdu-poetry/" class="group bg-white p-5 rounded-2xl border border-indigo-50 hover:border-accent hover:shadow-lg transition-all text-center">
						<span class="text-2xl block mb-2">✍️</span>
						<span class="font-bold text-sm text-primary group-hover:text-accent transition-colors">Urdu Poetry</span>
					</a>
				</div>
				<div class="text-center mt-8">
					<a href="/categories/" class="inline-flex items-center text-accent font-bold text-sm hover:underline">
						Browse all categories →
					</a>
				</div>
			</div>
		</section>

		{/* Why Linespedia Trust Section */}
		<section class="container mx-auto px-4 py-16 max-w-5xl">
			<h2 class="text-2xl font-serif font-black text-primary text-center mb-10">Why Linespedia?</h2>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="text-center">
					<div class="w-14 h-14 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
						<span class="text-2xl">📚</span>
					</div>
					<h3 class="font-bold text-primary mb-2">Public Domain & Attributed</h3>
					<p class="text-primary/60 text-sm">We curate public domain poetry with proper attribution. Every poem includes its source and author.</p>
				</div>
				<div class="text-center">
					<div class="w-14 h-14 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
						<span class="text-2xl">💡</span>
					</div>
					<h3 class="font-bold text-primary mb-2">Meanings & Context</h3>
					<p class="text-primary/60 text-sm">Every line comes with its meaning and context, helping you understand and appreciate the poetry.</p>
				</div>
				<div class="text-center">
					<div class="w-14 h-14 bg-indigo-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
						<span class="text-2xl">🎨</span>
					</div>
					<h3 class="font-bold text-primary mb-2">Share & Download</h3>
					<p class="text-primary/60 text-sm">Copy, share, or download beautiful quote posters for Instagram, WhatsApp, and social media.</p>
				</div>
			</div>
		</section>

		{/* SEO Content Block — ensures homepage is not thin */}
		<section class="container mx-auto px-4 py-16 max-w-4xl">
			<div class="prose prose-indigo max-w-none">
				<h2 class="text-3xl font-serif font-black text-primary">About Linespedia</h2>
				<p class="text-primary/70 leading-relaxed text-lg">
					Linespedia is a curated archive of shayari, poems, quotes, and poetic lines. We collect and organize poetry from legendary poets like Shakespeare, Emily Dickinson, Edgar Allan Poe, Mirza Ghalib, and many more. Whether you're looking for sad shayari to express your grief, love poetry to share with your partner, or deep lines for your Instagram captions — Linespedia has it all.
				</p>
				<p class="text-primary/70 leading-relaxed">
					Our collection spans multiple languages and moods. Every line is accompanied by its meaning and context, making it perfect for students, poetry enthusiasts, and social media users. Browse by writer, category, mood, or use our curated collections designed for specific platforms like Instagram, WhatsApp, and Facebook.
				</p>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
