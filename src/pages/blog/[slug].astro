---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Extract headings for TOC
const headings = post.body?.match(/^#{2,3} .+$/gm)?.map((h) => {
  const level = h.startsWith('###') ? 3 : 2;
  const text = h.replace(/^#{2,3} /, '');
  const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  return { level, text, id };
}) || [];
const allPosts = await getCollection("blog");

const authorName = post.data.author || "Linespedia Editorial";
const publishedISO = post.data.pubDate.toISOString();
const updatedISO = post.data.updatedDate
  ? post.data.updatedDate.toISOString()
  : publishedISO;
const canonicalURL = new URL(`/blog/${post.id}/`, Astro.site).toString();

const relatedPosts = allPosts
  .filter((item) => item.id !== post.id)
  .map((item) => {
    const currentTags = post.data.tags || [];
    const itemTags = item.data.tags || [];
    const sharedTags = itemTags.filter((tag) => currentTags.includes(tag));
    const categoryMatch = item.data.category === post.data.category ? 1 : 0;

    return {
      post: item,
      score: sharedTags.length * 2 + categoryMatch,
    };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((item) => item.post);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedISO,
  dateModified: updatedISO,
  author: {
    "@type": "Organization",
    name: authorName,
  },
  publisher: {
    "@type": "Organization",
    name: "Linespedia",
    url: "https://linespedia.com",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL,
  },
};

const breadcrumbs = [
  { name: "Home", href: "/" },
  { name: "Blog", href: "/blog/" },
  { name: post.data.title, href: `/blog/${post.id}/` },
];
export const prerender = true;
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  canonicalURL={canonicalURL}
  type="article"
  publishedTime={publishedISO}
  author={authorName}
  section={post.data.category}
  tags={post.data.tags || []}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />

  <Navbar />
  <main class="min-h-screen">
    <div class="relative h-[40vh] md:h-[45vh] flex items-center justify-center overflow-hidden">
        <div class="absolute inset-0 bg-primary/40 z-10"></div>
        <img 
            src={post.data.heroImage} 
            alt={post.data.title}
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="container mx-auto px-4 relative z-20 text-center">
            <Breadcrumb items={breadcrumbs} />
            <h1 class="text-4xl md:text-7xl font-serif font-black text-white mb-8 max-w-4xl mx-auto leading-tight">
                {post.data.title}
            </h1>
            <div class="flex items-center justify-center space-x-6 text-white/90">
                <div class="flex items-center space-x-2">
                    <span class="text-xs uppercase font-bold tracking-widest text-white/50">Author</span>
                    <span class="font-bold">{authorName}</span>
                </div>
                <div class="w-1 h-1 bg-white/30 rounded-full"></div>
                <time class="font-bold">
                    {post.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
                </time>
                {post.data.updatedDate && (
                    <>
                        <div class="w-1 h-1 bg-white/30 rounded-full"></div>
                        <time class="font-bold">
                            Updated {post.data.updatedDate.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}
                        </time>
                    </>
                )}
            </div>
        </div>
    </div>

    <article class="container mx-auto px-4 py-12">
      <div class="max-w-3xl mx-auto">
        {headings.length > 2 && (
          <nav class="mb-10 p-6 bg-indigo-50/50 rounded-2xl border border-indigo-100">
            <h2 class="text-sm font-bold uppercase tracking-widest text-primary/40 mb-4">Table of Contents</h2>
            <ul class="space-y-2">
              {headings.map((h) => (
                <li class={h.level === 3 ? 'ml-4' : ''}>
                  <a href={`#${h.id}`} class="text-sm text-primary/70 hover:text-accent transition-colors">{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <div class="prose prose-lg prose-indigo prose-headings:font-serif prose-headings:font-black prose-headings:scroll-mt-20 text-primary/80">
          <p class="lead text-lg text-primary/70 not-prose mb-8">{post.data.description}</p>
          <Content />
        </div>
      </div>

      <div class="max-w-3xl mx-auto mt-12 p-6 rounded-2xl bg-indigo-50/60 border border-indigo-100">
        <h2 class="text-2xl font-serif font-black text-primary mb-4">Read Next on Linespedia</h2>
        <p class="text-primary/70 mb-6">Explore related lines, collections, and editorial guides to continue your reading.</p>
        <ul class="space-y-3 text-primary/90">
          <li><a class="hover:text-accent font-semibold" href="/explore/">Browse trending lines and quotes</a></li>
          <li><a class="hover:text-accent font-semibold" href="/collections/">Explore thematic line collections</a></li>
          <li><a class="hover:text-accent font-semibold" href="/categories/">Find posts by category</a></li>
          <li><a class="hover:text-accent font-semibold" href="/writers/">Read writer profiles and featured poets</a></li>
          <li><a class="hover:text-accent font-semibold" href="/blog/">Visit the full blog archive</a></li>
        </ul>
      </div>

      {relatedPosts.length > 0 && (
        <section class="max-w-3xl mx-auto mt-10">
          <h2 class="text-2xl font-serif font-black text-primary mb-5">Related Posts</h2>
          <div class="grid gap-4">
            {relatedPosts.map((relatedPost) => (
              <a href={`/blog/${relatedPost.id}/`} class="block rounded-2xl border border-indigo-100 p-5 hover:border-accent transition-colors bg-white/80">
                <h3 class="font-bold text-lg text-primary mb-1">{relatedPost.data.title}</h3>
                <p class="text-primary/70 text-sm">{relatedPost.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>

    {/* Shared Section */}
    <div class="bg-indigo-50 py-20 px-4">
        <div class="container mx-auto max-w-4xl text-center">
            <h2 class="text-3xl font-serif font-black text-primary mb-6">Found inspiration in these words?</h2>
            <p class="text-primary/60 mb-10">Explore our curated collection of poems and shayari to share with your audience.</p>
            <a href="/explore" class="inline-flex items-center space-x-2 bg-primary text-white px-10 py-5 rounded-full font-bold hover:bg-accent transition-all shadow-2xl">
                <span>Start Exploring</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </a>
        </div>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
    /* Custom prose styles for a more poetic feel */
    .prose blockquote {
        border-left-width: 4px;
        border-color: var(--color-accent);
        font-style: italic;
        color: color-mix(in srgb, var(--color-primary) 60%, transparent);
        padding-left: 2rem;
        margin-top: 2.5rem;
        margin-bottom: 2.5rem;
        font-family: serif;
    }
    .prose h2 {
        margin-top: 5rem;
        margin-bottom: 2rem;
    }
</style>
