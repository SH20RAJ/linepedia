---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getAllCategories } from '../lib/cdn';
import { buildCanonicalUrl, generatePageMetadata, getNormalizedLang, getSiteOrigin, SUPPORTED_LANGUAGES, shouldNoindexForLanguageParam } from '../lib/seo';

const categoriesData = await getAllCategories();

// Language detection
const supportedLanguages: string[] = [...SUPPORTED_LANGUAGES];
const requestedLang = Astro.url.searchParams.get("lang") || "en";
const lang = supportedLanguages.includes(requestedLang) ? requestedLang : "en";
const siteOrigin = getSiteOrigin(Astro.site, Astro.url.origin);
const canonicalURL = buildCanonicalUrl('/categories/', siteOrigin);
const shouldNoindex = getNormalizedLang(requestedLang) !== 'en';
const isTranslationParamPage = shouldNoindexForLanguageParam(Astro.url.searchParams);
const robots = shouldNoindex
	? 'noindex,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'
	: 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1';

const categoriesMeta = generatePageMetadata({
	pageType: 'archive',
	data: {
		name: 'Categories',
		description: 'Explore poetry and shayari by mood, theme, and category.',
	},
	siteOrigin,
	pathname: '/categories/',
	lang,
	itemCount: categoriesData.length,
	fallbackTitle: 'Categories',
	fallbackDescription: 'Explore poetry and shayari by mood, theme, and category.',
});

---

<Layout 
	title={categoriesMeta.title}
	description={categoriesMeta.description}
  lang={lang}
	canonicalURL={categoriesMeta.canonicalURL}
	robots={categoriesMeta.robots}
	ogTitle={categoriesMeta.ogTitle}
	ogDescription={categoriesMeta.ogDescription}
	ogUrl={categoriesMeta.ogUrl}
	twitterCard={categoriesMeta.twitterCard}
  keywords="poetry categories, shayari themes, poem genres, mood based poetry, thematic collections"
>
  {!isTranslationParamPage && <meta slot="head" name="lang-trigger" content={lang} />}

  <Navbar />
	<main class="min-h-screen py-20 px-4">
		<div class="container mx-auto">
			<h1 class="text-5xl font-serif font-black text-primary mb-12">Categories</h1>
			<p class="max-w-3xl text-primary/60 mb-12 leading-relaxed">Browse thematic category pages built from real archive entries. Each category groups lines by mood, style, or recurring topic.</p>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{categoriesData.map(cat => (
					<a href={`/${cat.slug}`} class="group p-8 bg-white border border-indigo-50 rounded-[2.5rem] shadow-sm hover:shadow-xl transition-all">
						<h2 class="text-3xl font-serif font-bold text-primary group-hover:text-accent transition-colors mb-4">{cat.name}</h2>
						<p class="text-primary/60 leading-relaxed mb-6">{cat.description}</p>
						<span class="text-xs font-bold uppercase tracking-widest text-accent">Browse Collection &rarr;</span>
					</a>
				))}
			</div>
		</div>
	</main>
	<Footer />
</Layout>
