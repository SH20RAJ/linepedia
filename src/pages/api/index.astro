---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { generatePageMetadata } from '../../lib/seo';

const siteOrigin = Astro.site?.toString()?.replace(/\/$/, '') || 'https://linespedia.com';
const meta = generatePageMetadata({
  pageType: 'archive',
  data: {
    title: 'Poetry API',
    description: 'Access shayari, poems, and quotes programmatically. Free tier available. Perfect for apps, bots, and websites.',
  },
  siteOrigin,
  pathname: '/api/',
  fallbackTitle: 'Poetry API — Linespedia',
  fallbackDescription: 'Access shayari, poems, and quotes programmatically. Free tier available for developers.',
});
---

<Layout title={meta.title} description={meta.description} canonicalURL={meta.canonicalURL} robots={meta.robots}>
  <Navbar />
  <main class="min-h-screen">
    {/* Hero */}
    <section class="container mx-auto px-4 py-20 md:py-32 text-center max-w-4xl">
      <span class="inline-block px-4 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-bold uppercase tracking-widest mb-6">Developer API</span>
      <h1 class="text-4xl md:text-6xl font-serif font-black text-primary mb-6 leading-tight">
        Poetry API for Developers
      </h1>
      <p class="text-lg md:text-xl text-primary/60 leading-relaxed max-w-2xl mx-auto mb-10">
        Access thousands of shayari, poems, and quotes programmatically. Build poetry features into your apps, bots, and websites.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#endpoints" class="px-8 py-4 bg-primary text-white rounded-full font-bold hover:bg-primary/90 transition-all shadow-lg">
          View Endpoints
        </a>
        <a href="/contact/" class="px-8 py-4 bg-white border border-indigo-200 text-primary rounded-full font-bold hover:shadow-lg transition-all">
          Request API Access
        </a>
      </div>
    </section>

    {/* Use Cases */}
    <section class="bg-indigo-50/50 py-20">
      <div class="container mx-auto px-4 max-w-5xl">
        <h2 class="text-3xl font-serif font-black text-primary text-center mb-12">What You Can Build</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-2xl border border-indigo-50 shadow-sm">
            <div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center mb-4 text-indigo-600 text-xl">💬</div>
            <h3 class="font-bold text-primary mb-2">Chat Bots</h3>
            <p class="text-primary/60 text-sm">Add daily poetry, random quotes, or mood-based shayari to your WhatsApp/Telegram bot.</p>
          </div>
          <div class="bg-white p-8 rounded-2xl border border-indigo-50 shadow-sm">
            <div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center mb-4 text-indigo-600 text-xl">📱</div>
            <h3 class="font-bold text-primary mb-2">Mobile Apps</h3>
            <p class="text-primary/60 text-sm">Integrate poetry discovery, search, and daily inspiration into your iOS or Android app.</p>
          </div>
          <div class="bg-white p-8 rounded-2xl border border-indigo-50 shadow-sm">
            <div class="w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center mb-4 text-indigo-600 text-xl">🌐</div>
            <h3 class="font-bold text-primary mb-2">Websites</h3>
            <p class="text-primary/60 text-sm">Embed quote-of-the-day widgets, poetry search, or curated collections on your website.</p>
          </div>
        </div>
      </div>
    </section>

    {/* Endpoints */}
    <section id="endpoints" class="container mx-auto px-4 py-20 max-w-4xl">
      <h2 class="text-3xl font-serif font-black text-primary text-center mb-12">API Endpoints</h2>
      <div class="space-y-6">
        <div class="bg-white p-6 rounded-2xl border border-indigo-100 shadow-sm">
          <div class="flex items-center gap-3 mb-3">
            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">GET</span>
            <code class="text-sm font-mono text-primary">/api/v1/random</code>
          </div>
          <p class="text-primary/60 text-sm mb-2">Returns a random poem/line with author, categories, and meaning.</p>
          <pre class="bg-gray-50 p-4 rounded-xl text-xs overflow-x-auto"><code set:html={`{"id": "poem-slug", "content": "...", "writer": "Poet Name", "categories": ["love", "urdu"], "meaning": "..."}`} /></pre>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-indigo-100 shadow-sm">
          <div class="flex items-center gap-3 mb-3">
            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">GET</span>
            <code class="text-sm font-mono text-primary">/api/v1/search?q=&#123;query&#125;</code>
          </div>
          <p class="text-primary/60 text-sm mb-2">Search poems by keyword, author, category, or mood.</p>
          <pre class="bg-gray-50 p-4 rounded-xl text-xs overflow-x-auto"><code set:html={`{"results": [...], "total": 42, "page": 1}`} /></pre>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-indigo-100 shadow-sm">
          <div class="flex items-center gap-3 mb-3">
            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">GET</span>
            <code class="text-sm font-mono text-primary">/api/v1/categories</code>
          </div>
          <p class="text-primary/60 text-sm mb-2">List all available poetry categories with descriptions.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-indigo-100 shadow-sm">
          <div class="flex items-center gap-3 mb-3">
            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">GET</span>
            <code class="text-sm font-mono text-primary">/api/v1/writers</code>
          </div>
          <p class="text-primary/60 text-sm mb-2">List all poets/writers in the archive.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-indigo-100 shadow-sm">
          <div class="flex items-center gap-3 mb-3">
            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-bold">GET</span>
            <code class="text-sm font-mono text-primary">/api/v1/poem/&#123;slug&#125;</code>
          </div>
          <p class="text-primary/60 text-sm mb-2">Get a specific poem by its slug with full metadata.</p>
        </div>
      </div>
    </section>

    {/* Pricing */}
    <section class="bg-indigo-900 text-white py-20">
      <div class="container mx-auto px-4 max-w-4xl text-center">
        <h2 class="text-3xl font-serif font-black mb-12">Simple Pricing</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white/10 backdrop-blur p-8 rounded-2xl border border-white/10">
            <h3 class="font-bold text-xl mb-2">Free</h3>
            <p class="text-3xl font-serif font-black mb-4">$0</p>
            <ul class="text-sm text-white/70 space-y-2 text-left mb-6">
              <li>100 requests/day</li>
              <li>All endpoints</li>
              <li>JSON responses</li>
              <li>Attribution required</li>
            </ul>
            <a href="/contact/" class="block py-3 bg-white/10 rounded-xl text-center text-sm font-bold hover:bg-white/20 transition-all">Get Started</a>
          </div>
          <div class="bg-white/20 backdrop-blur p-8 rounded-2xl border border-accent relative">
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-accent text-white text-xs font-bold rounded-full">Popular</span>
            <h3 class="font-bold text-xl mb-2">Pro</h3>
            <p class="text-3xl font-serif font-black mb-4">$19<span class="text-lg font-normal">/mo</span></p>
            <ul class="text-sm text-white/70 space-y-2 text-left mb-6">
              <li>10,000 requests/day</li>
              <li>All endpoints</li>
              <li>Priority support</li>
              <li>No attribution required</li>
            </ul>
            <a href="/contact/" class="block py-3 bg-accent rounded-xl text-center text-sm font-bold hover:bg-accent/90 transition-all">Request Access</a>
          </div>
          <div class="bg-white/10 backdrop-blur p-8 rounded-2xl border border-white/10">
            <h3 class="font-bold text-xl mb-2">Business</h3>
            <p class="text-3xl font-serif font-black mb-4">Custom</p>
            <ul class="text-sm text-white/70 space-y-2 text-left mb-6">
              <li>Unlimited requests</li>
              <li>Bulk dataset license</li>
              <li>Custom endpoints</li>
              <li>Dedicated support</li>
            </ul>
            <a href="/contact/" class="block py-3 bg-white/10 rounded-xl text-center text-sm font-bold hover:bg-white/20 transition-all">Contact Us</a>
          </div>
        </div>
      </div>
    </section>

    {/* CTA */}
    <section class="container mx-auto px-4 py-20 text-center max-w-2xl">
      <h2 class="text-3xl font-serif font-black text-primary mb-4">Ready to build with poetry?</h2>
      <p class="text-primary/60 mb-8">Get your API key and start integrating poetry into your applications today.</p>
      <a href="/contact/" class="inline-block px-10 py-4 bg-primary text-white rounded-full font-bold text-lg hover:bg-primary/90 transition-all shadow-lg">
        Request API Access
      </a>
    </section>
  </main>
  <Footer />
</Layout>
