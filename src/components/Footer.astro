---
import { Github } from "lucide-astro";

const year = new Date().getFullYear();
---

<footer class="bg-primary text-secondary pt-16 pb-8 px-4 mt-auto">
  <div class="container mx-auto grid grid-cols-1 md:grid-cols-5 gap-12 mb-12">
    <div class="col-span-1 md:col-span-1">
      <h2 class="text-2xl font-serif font-bold text-white mb-3">Linespedia</h2>
      <p class="max-w-xs text-secondary/70 leading-relaxed text-sm">
        A curated archive of shayari, poems, quotes, and poetic lines — with meanings, context, and attribution.
      </p>
    </div>

    <div>
      <h3 class="text-white font-bold mb-4 uppercase tracking-widest text-xs">
        Browse
      </h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/explore/" class="hover:text-accent transition-colors">Explore</a></li>
        <li><a href="/categories/" class="hover:text-accent transition-colors">Categories</a></li>
        <li><a href="/writers/" class="hover:text-accent transition-colors">Writers</a></li>
        <li><a href="/collections/" class="hover:text-accent transition-colors">Collections</a></li>
        <li><a href="/blog/" class="hover:text-accent transition-colors">Blog</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white font-bold mb-4 uppercase tracking-widest text-xs">
        Shayari
      </h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/sad-shayari/" class="hover:text-accent transition-colors">Sad Shayari</a></li>
        <li><a href="/love-shayari/" class="hover:text-accent transition-colors">Love Shayari</a></li>
        <li><a href="/attitude-shayari/" class="hover:text-accent transition-colors">Attitude Shayari</a></li>
        <li><a href="/best-shayari/" class="hover:text-accent transition-colors">Best Shayari</a></li>
        <li><a href="/emotional-shayari/" class="hover:text-accent transition-colors">Emotional Shayari</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white font-bold mb-4 uppercase tracking-widest text-xs">
        Quotes &amp; Captions
      </h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/life-quotes/" class="hover:text-accent transition-colors">Life Quotes</a></li>
        <li><a href="/motivational-quotes/" class="hover:text-accent transition-colors">Motivational Quotes</a></li>
        <li><a href="/instagram-captions/" class="hover:text-accent transition-colors">Instagram Captions</a></li>
        <li><a href="/quotes/" class="hover:text-accent transition-colors">Quotes</a></li>
        <li><a href="/friendship-shayari/" class="hover:text-accent transition-colors">Friendship Shayari</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white font-bold mb-4 uppercase tracking-widest text-xs">
        Products
      </h3>
      <ul class="space-y-2 text-sm">
        <li><a href="/api/" class="hover:text-accent transition-colors">Poetry API</a></li>
        <li><a href="/posters/" class="hover:text-accent transition-colors">Quote Posters</a></li>
        <li>
          <a href="https://scriptly.store?ref=linespedia_footer" target="_blank" rel="noopener noreferrer" class="hover:text-[#58CC02] transition-colors flex items-center space-x-2">
            <span>ScriptlyStore</span>
            <span class="px-1.5 py-0.5 bg-[#58CC02]/20 text-[#58CC02] text-[8px] font-black uppercase tracking-widest rounded-sm">New</span>
          </a>
        </li>
        <li>
          <a href="https://sopkit.github.io/" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors flex items-center space-x-2">
            <span>SopKit</span>
          </a>
        </li>
        <li><a href="/sponsor/" class="hover:text-accent transition-colors">Sponsor</a></li>
        <li><a href="/submit/" class="hover:text-accent transition-colors">Submit Line</a></li>
      </ul>
    </div>
  </div>

  <div
    class="container mx-auto border-t border-secondary/10 pt-8 flex flex-col md:flex-row justify-between items-center text-xs opacity-60"
  >
    <div class="flex flex-col items-center md:items-start space-y-4">
      <p>&copy; {year} Linespedia. All rights reserved.</p>
    </div>
    <div class="flex space-x-6 mt-4 md:mt-0 flex-wrap justify-center md:justify-end gap-4">
      <a href="/about/" class="hover:text-white transition-colors">About</a>
      <a href="/contact/" class="hover:text-white transition-colors">Contact</a>
      <a href="/copyright/" class="hover:text-white transition-colors">Copyright & Report</a>
      <a href="/privacy/" class="hover:text-white transition-colors">Privacy Policy</a>
      <a href="/terms/" class="hover:text-white transition-colors">Terms of Service</a>
      <a href="/sitemap.xml" class="hover:text-white transition-colors">Sitemap</a>
    </div>
  </div>
</footer>
