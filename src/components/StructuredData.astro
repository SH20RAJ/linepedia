---
interface Props {
  type: "line" | "writer" | "category" | "collection" | "story" | "blog" | "programmatic-seo" | "programmatic" | "archive" | "home";
  title: string;
  description: string;
  url: string;
  language?: string;
  authorName?: string;
  datePublished?: string;
  dateModified?: string;
  image?: string;
  breadcrumbs?: { name: string; url: string }[];
  faqs?: { q: string; a: string }[];
  itemCount?: number;
}

const {
  type,
  title,
  description,
  url,
  language,
  authorName,
  datePublished,
  dateModified,
  image,
  breadcrumbs = [],
  faqs = [],
  itemCount,
} = Astro.props;
const siteUrl = Astro.site?.toString()?.replace(/\/$/, '') || "https://library.linespedia.com";
const inferredLanguage = String(Astro.url.searchParams.get("lang") || "en").toLowerCase();
const schemaLanguage = language || inferredLanguage;

// Organization schema (sitewide)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}#organization`,
  name: "Linespedia",
  url: siteUrl,
  logo: {
    "@type": "ImageObject",
    url: `${siteUrl}/favicon.svg`,
    width: 512,
    height: 512,
  },
  description: "A curated archive of shayari, poems, quotes, and poetic lines.",
  sameAs: [
    "https://github.com/SH20RAJ/linepedia",
  ],
};

// WebSite schema with SearchAction (sitewide)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}#website`,
  name: "Linespedia",
  url: siteUrl,
  inLanguage: schemaLanguage,
  publisher: {
    "@id": `${siteUrl}#organization`,
  },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteUrl}/explore/?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const resolvedUrl = url.startsWith("http") ? url : `${siteUrl}/${url.replace(/^\/+/, '')}`;

// WebPage schema (sitewide)
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": type === "writer" ? "ProfilePage" : (type === "category" || type === "collection" || type === "programmatic-seo" || type === "programmatic") ? "CollectionPage" : "WebPage",
  "@id": `${resolvedUrl}#webpage`,
  url: resolvedUrl,
  name: title,
  description: description,
  isPartOf: {
    "@id": `${siteUrl}#website`,
  },
  inLanguage: schemaLanguage,
  datePublished: datePublished || undefined,
  dateModified: dateModified || datePublished || undefined,
};

// Breadcrumb schema
const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((crumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: crumb.name,
          item: crumb.url.startsWith("http")
            ? crumb.url
            : `${siteUrl}/${crumb.url.replace(/^\/+/, '')}`,
        })),
      }
    : null;

// Content schema based on type
const contentSchema =
  type === "line"
    ? {
        "@context": "https://schema.org",
        "@type": "Poem",
        "@id": `${resolvedUrl}#poem`,
        name: title,
        description: description,
        text: description,
        inLanguage: schemaLanguage,
        author: {
          "@type": "Person",
          name: authorName || "Unknown Author",
        },
        creator: {
          "@type": "Person",
          name: authorName || "Unknown Author",
        },
        genre: "Poetry",
        url: resolvedUrl,
        datePublished: datePublished || undefined,
        dateModified: dateModified || datePublished || undefined,
        publisher: {
          "@id": `${siteUrl}#organization`,
        },
        isAccessibleForFree: true,
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": resolvedUrl,
        },
        image: image || undefined,
      }
    : type === "writer"
      ? {
          "@context": "https://schema.org",
          "@type": "Person",
          "@id": `${resolvedUrl}#person`,
          name: title,
          description: description,
          inLanguage: schemaLanguage,
          url: resolvedUrl,
          image: image || undefined,
          mainEntityOfPage: {
            "@id": `${resolvedUrl}#webpage`,
          },
        }
      : type === "blog"
        ? {
            "@context": "https://schema.org",
            "@type": "BlogPosting",
            "@id": `${resolvedUrl}#blogposting`,
            headline: title,
            description: description,
            inLanguage: schemaLanguage,
            url: resolvedUrl,
            datePublished: datePublished || undefined,
            dateModified: dateModified || datePublished || undefined,
            author: authorName
              ? { "@type": "Person", name: authorName }
              : { "@type": "Organization", name: "Linespedia" },
            publisher: {
              "@id": `${siteUrl}#organization`,
            },
            mainEntityOfPage: {
              "@type": "WebPage",
              "@id": resolvedUrl,
            },
            image: image || undefined,
          }
        : type === "story"
          ? {
              "@context": "https://schema.org",
              "@type": "ShortStory",
              "@id": `${resolvedUrl}#story`,
              name: title,
              description: description,
              inLanguage: schemaLanguage,
              url: resolvedUrl,
              publisher: {
                "@id": `${siteUrl}#organization`,
              },
              isPartOf: {
                "@type": "CreativeWorkSeries",
                name: "Panchatantra Tales",
              },
            }
          : type === "blog" || type === "line" || type === "home" || type === "writer" || type === "story" ? null : {
              "@context": "https://schema.org",
              "@type": "ItemList",
              "@id": `${resolvedUrl}#itemlist`,
              name: title,
              description: description,
              url: resolvedUrl,
              ...(itemCount ? { numberOfItems: itemCount } : {}),
              itemListElement: [],
            };

// FAQ Schema
const faqSchema =
  faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        inLanguage: schemaLanguage,
        mainEntity: faqs.map((faq) => ({
          "@type": "Question",
          name: faq.q,
          acceptedAnswer: {
            "@type": "Answer",
            text: faq.a,
          },
        })),
      }
    : null;
---

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
{faqSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}
{contentSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(contentSchema)} />
)}
