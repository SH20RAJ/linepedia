---
// src/components/SopkitBacklink.astro
// Dynamically fetches the SopKit sitemap and renders a random dofollow backlink to one of its tools.

let randomUrl = "https://sopkit.github.io/";
let anchorText = "Free Tools by SopKit";

try {
  // Fetch the sitemap with caching so we don't bombard the server on every SSR request
  const res = await fetch("https://sopkit.github.io/sitemap.xml", {
    next: { revalidate: 3600 }
  });
  
  if (res.ok) {
    const xmlText = await res.text();
    // Use regex to extract all <loc> tags
    const matches = [...xmlText.matchAll(/<loc>(.*?)<\/loc>/g)];
    
    if (matches.length > 0) {
      // Filter out non-tool pages like about, contact, privacy, dmca, terms, etc.
      const excludedPaths = ['/about', '/contact', '/privacy', '/terms', '/dmca', '/pro', '/advertise', '/services'];
      
      const validUrls = matches
        .map(match => match[1])
        .filter(url => {
          const path = new URL(url).pathname;
          // Return true if path is NOT in excluded paths, or if it explicitly has '-tools'
          if (excludedPaths.some(excluded => path.includes(excluded))) return false;
          return true;
        });

      if (validUrls.length > 0) {
        // Select a random URL from the filtered list
        randomUrl = validUrls[Math.floor(Math.random() * validUrls.length)];
        
        // Generate descriptive anchor text based on the URL path
        // e.g. "https://sopkit.github.io/pdf-tools" -> "Pdf Tools"
        const pathSlug = new URL(randomUrl).pathname.replace(/\//g, '').replace(/-/g, ' ').trim();
        
        if (pathSlug) {
           // Title case the slug
           anchorText = pathSlug.replace(
             /\w\S*/g,
             (txt) => txt.charAt(0).toUpperCase() + txt.substring(1).toLowerCase()
           ) + " by SopKit";
        } else {
           anchorText = "Free Online Tools by SopKit";
        }
      }
    }
  }
} catch (e) {
  console.error("Failed to fetch SopKit sitemap for dynamic backlink:", e);
}
---

<div class="mt-8 pt-6 border-t border-indigo-50 flex items-center justify-center">
  <span class="text-xs text-primary/40 font-medium">
    Sponsored: <a href={randomUrl} target="_blank" class="text-indigo-500 hover:text-indigo-600 font-bold hover:underline transition-all">{anchorText}</a>
  </span>
</div>
