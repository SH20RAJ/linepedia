---
import '../styles/global.css';
import Newsletter from '../components/Newsletter.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
	robots?: string;
	ogTitle?: string;
	ogDescription?: string;
	ogUrl?: string;
	robotsMeta?: string;
	prevURL?: string;
	nextURL?: string;
	type?: 'website' | 'article';
	lang?: string;
	publishedTime?: string;
	author?: string;
	section?: string;
	tags?: string[];
	keywords?: string;
	twitterCard?: 'summary' | 'summary_large_image';
}

const {
	title,
	description = "Linespedia - Your source for the best shayari, poems, and inspiring lines.",
	image = "/og-image.png", // Default OG image
	canonicalURL = Astro.url.href,
	robotsMeta = undefined,
	type = 'website',
	lang = 'en',
	publishedTime,
	author,
	section,
	tags = [],
	keywords,
	robots,
	ogTitle,
	ogDescription,
	ogUrl,
	twitterCard = 'summary_large_image',
	prevURL,
	nextURL,
} = Astro.props;

const siteName = "Linespedia";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const resolvedOgTitle = ogTitle || fullTitle;
const resolvedOgDescription = ogDescription || description;
const resolvedOgUrl = ogUrl || canonicalURL;
const robotsContent = robotsMeta || robots || 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1';

// Language mapping for Open Graph locale format
const localeMap: Record<string, string> = {
	en: 'en_US',
	es: 'es_ES',
	fr: 'fr_FR',
	de: 'de_DE',
	hi: 'hi_IN',
	ar: 'ar_SA',
	zh: 'zh_CN',
	ja: 'ja_JP',
	ru: 'ru_RU',
	pt: 'pt_BR',
	it: 'it_IT',
};
const currentLocale = localeMap[lang] || 'en_US';

// Alternate locales: include at least English as fallback
const supportedLanguages = ['en', 'es', 'fr', 'de', 'hi', 'ar', 'zh', 'ja', 'ru', 'pt', 'it'];
const alternateLocales = supportedLanguages
	.filter((l) => l !== lang)
	.map((l) => localeMap[l] || l.toUpperCase());
---

<!DOCTYPE html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
	<head>
		<meta charset="UTF-8" />
 		<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap.xml" />
<meta name="generator" content={Astro.generator} />

<!-- Preconnect for performance -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://www.googletagmanager.com" />
<link rel="preconnect" href="https://pagead2.googlesyndication.com" />
<link rel="dns-prefetch" href="https://pagead2.googlesyndication.com">
<link rel="dns-prefetch" href="https://www.googletagmanager.com">
<link rel="dns-prefetch" href="https://fonts.googleapis.com">

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-9LWSBZ57GZ"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-9LWSBZ57GZ');
</script>

<!-- Google AdSense -->
<meta name="google-adsense-account" content="ca-pub-1828915420581549">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1828915420581549" crossorigin="anonymous"></script>

 		<!-- Primary Meta Tags -->
 		<title>{fullTitle}</title>
 		<meta name="title" content={fullTitle} />
 		<meta name="description" content={description} />
 		{keywords && <meta name="keywords" content={keywords} />}
 		<link rel="canonical" href={canonicalURL} />
		{prevURL && <link rel="prev" href={prevURL} />}
		{nextURL && <link rel="next" href={nextURL} />}

  		<!-- Open Graph / Facebook -->
  		<meta property="og:type" content={type} />
	  	<meta property="og:url" content={resolvedOgUrl} />
  		<meta property="og:site_name" content={siteName} />
	  	<meta property="og:title" content={resolvedOgTitle} />
	  	<meta property="og:description" content={resolvedOgDescription} />
  		<meta property="og:image" content={new URL(image, Astro.url)} />
  		<meta property="og:locale" content={currentLocale} />
 		{alternateLocales.map((locale) => (
 			<meta property="og:locale:alternate" content={locale} />
 		))}

 		{type === 'article' && publishedTime && (
 			<meta property="article:published_time" content={publishedTime} />
 		)}
 		{type === 'article' && author && <meta property="article:author" content={author} />}
 		{type === 'article' && section && <meta property="article:section" content={section} />}
 		{type === 'article' &&
 			tags.map((tag) => <meta property="article:tag" content={tag} />)}

		<!-- Twitter -->
		<meta property="twitter:card" content={twitterCard} />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={resolvedOgTitle} />
		<meta property="twitter:description" content={resolvedOgDescription} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />
		<meta name="twitter:site" content="@sh20raj" />

		<!-- Verification Tags -->
		<meta name="robots" content={robotsContent} />
		<meta name="theme-color" content="#4f46e5" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="Linespedia" />
		<meta name="application-name" content="Linespedia" />
		<meta name="msapplication-TileColor" content="#4f46e5" />

		<!-- Performance Optimization -->
		<link rel="dns-prefetch" href="https://pagead2.googlesyndication.com">
		<link rel="dns-prefetch" href="https://www.googletagmanager.com">
		<link rel="dns-prefetch" href="https://fonts.googleapis.com">
		
		<slot name="head" />
		<!-- Defer non-critical scripts: load after page interactive -->
		<script is:inline>
			window.addEventListener('load', function() {
				// Load Puter.js after page is interactive
				var puterScript = document.createElement('script');
				puterScript.src = 'https://js.puter.com/v2/';
				puterScript.defer = true;
				document.head.appendChild(puterScript);

				// Load Google Translate only when needed
				function googleTranslateElementInit() {
					if (typeof google !== 'undefined' && google.translate) {
						new google.translate.TranslateElement({
							pageLanguage: 'en',
							autoDisplay: false,
							layout: google.translate.TranslateElement.InlineLayout.SIMPLE
						}, 'google_translate_element');
					}
				}
				window.googleTranslateElementInit = googleTranslateElementInit;
				var translateScript = document.createElement('script');
				translateScript.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
				translateScript.defer = true;
				document.head.appendChild(translateScript);

				// Load Tally popup only after user interaction or idle
				var tallyLoaded = false;
				function loadTally() {
					if (tallyLoaded) return;
					tallyLoaded = true;
					if (typeof localStorage !== 'undefined' && !localStorage.getItem('tally-popup-seen')) {
						window.TallyConfig = {
							"formId": "0QLAzQ",
							"popup": {
								"emoji": { "text": "\ud83d\udc4b", "animation": "wave" },
								"open": { "trigger": "delay", "delay": 30 },
								"doNotShowAfterSubmit": true,
								"autoClose": 3000
							}
						};
						var tallyScript = document.createElement('script');
						tallyScript.src = 'https://tally.so/widgets/embed.js';
						tallyScript.async = true;
						document.head.appendChild(tallyScript);
						localStorage.setItem('tally-popup-seen', 'true');
					}
				}
				if ('requestIdleCallback' in window) {
					requestIdleCallback(loadTally, { timeout: 10000 });
				} else {
					setTimeout(loadTally, 5000);
				}
			});
		</script>
	</head>
	<body class="min-h-screen flex flex-col">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-50 bg-indigo-600 text-white px-4 py-2 rounded-lg shadow-lg focus:outline-none">Skip to content</a>
		<main id="main-content">
			<slot />
		</main>
		<Newsletter />
		<script is:inline>
			(() => {
				if (typeof window === 'undefined' || !('serviceWorker' in navigator)) {
					return;
				}

				window.addEventListener('load', async () => {
					try {
						const registration = await navigator.serviceWorker.register('/sw.js', { scope: '/' });
						registration.update().catch(() => undefined);
					} catch (error) {
						console.error('Service worker registration failed:', error);
					}
				});
			})();
		</script>
		<script is:inline>
			(() => {
				let deferredPrompt = null;

				window.addEventListener('beforeinstallprompt', (event) => {
					event.preventDefault();
					deferredPrompt = event;
					window.dispatchEvent(new CustomEvent('pwa:install-available'));
				});

				window.addEventListener('appinstalled', () => {
					deferredPrompt = null;
					window.dispatchEvent(new CustomEvent('pwa:installed'));
				});

				window.triggerPWAInstall = async () => {
					if (!deferredPrompt) {
						return { supported: false, outcome: 'unavailable' };
					}

					deferredPrompt.prompt();
					const choice = await deferredPrompt.userChoice;
					deferredPrompt = null;
					return { supported: true, outcome: choice?.outcome || 'dismissed' };
				};
			})();
		</script>
	</body>
</html>
